# Copy this file to .env and fill in your values.
# ORIGINAL keys (from the base TripMate AI repo) are marked [original].
# ADDED keys (for the new Weather Agent, Local Info Agent, and
# structured persistence) are marked [added].

# --- Groq (LLM) [original] -------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# --- AviationStack (flights — live/status data, NOT ticket prices) [original]
# Free tier: https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=your_aviationstack_api_key

# --- Tavily (hotel search via web search) [original] ------------
# Free tier: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# --- Default origin airport if none is parsed from the query [original]
DEFAULT_ORIGIN_IATA=DAC

# --- PostgreSQL [original + added] -------------------------------
# Used for BOTH: (1) LangGraph's conversation checkpointer (original),
# and (2) the new structured travel_plan_records table (added).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- OpenWeatherMap (NEW: Weather Agent) [added] -----------------
# Free tier: 1,000 calls/day. https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweathermap_key

# --- OpenTripMap (NEW: Local Info Agent) [added] -----------------
# Free tier: 5,000 calls/day. https://opentripmap.io/developer
OPENTRIPMAP_API_KEY=your_opentripmap_key
